    <string name="tvplayer_scene_off" translatable="false">Aus</string>
    <string name="tvplayer_scene_nordlicht" translatable="false">Nordlicht</string>
    <string name="tvplayer_scene_mitternacht" translatable="false">Mitternacht</string>
    <string name="tvplayer_scene_off_desc" translatable="false">Cyan Blau, ruhig, ohne Animation</string>
    <string name="tvplayer_scene_nordlicht_desc" translatable="false">Polarlicht über Bergen und See, in der Ferne leuchtet ein Stadion</string>
    <string name="tvplayer_scene_mitternacht_desc" translatable="false">Mond, lila Hügel und Glühwürmchen</string>
    <string name="tvplayer_scene_tiefsee" translatable="false">Tiefsee</string>
    <string name="tvplayer_scene_mondwueste" translatable="false">Mondwüste</string>
    <string name="tvplayer_scene_glimmwald" translatable="false">Glimmwald</string>
    <string name="tvplayer_scene_hafenlichter" translatable="false">Hafenlichter</string>
    <string name="tvplayer_scene_tiefsee_desc" translatable="false">Lichtstrahlen von oben, leuchtende Quallen, ein Manta und ein versunkenes Tor mit Anglerfisch als Torwart</string>
    <string name="tvplayer_scene_mondwueste_desc" translatable="false">Großer Mond über lila Dünen, Milchstraße, Sternschnuppen, eine Karawane und ein Stadion am Horizont</string>
    <string name="tvplayer_scene_glimmwald_desc" translatable="false">Leuchtpilze im Nachtwald, Mondlicht zwischen den Stämmen, Glühwürmchen und ein Hexenring als Mittelkreis</string>
    <string name="tvplayer_scene_hafenlichter_desc" translatable="false">Hafen bei Nacht mit Kirchturm, Fernsehturm, Konzerthaus und Kränen, Lichter im Wasser, ein Frachter zieht vorbei</string>
    <string name="tvplayer_stadium_title" translatable="false">Flutlicht bei Fußball</string>
    <string name="tvplayer_stadium_line" translatable="false">Stadion bei Nacht in Live-TV und Guide, wenn Fußball läuft</string>
    <string name="tvplayer_more_backup" translatable="false">Sicherung</string>
    <string name="tvplayer_keys_heading" translatable="false">Tasten im Vollbild</string>
    <string name="tvplayer_keys_help" translatable="false">Was die Tasten der Fernbedienung beim Fernsehen im Vollbild tun. Kurz drücken und gedrückt halten lassen sich getrennt belegen. Ab Werk wie bei TiviMate.</string>
